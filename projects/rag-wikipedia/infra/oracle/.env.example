# Copy to .env next to compose.yml on the Oracle box. Nothing here is secret
# except SNAPSHOT_URL if you use a signed link.

# The hostname Caddy gets a certificate for. Point its DNS at the box first.
DOMAIN=rag.example.org

# Where the frontend lives (Cloudflare Pages). NOT "*": the API answers a browser
# only for this origin.
ALLOWED_ORIGINS=https://rag-wikipedia.pages.dev

# The corpus, as a Qdrant snapshot. 328 MB measured for 87,173 chunks; restoring
# it takes a minute, where re-ingesting takes hours of embedding.
SNAPSHOT_URL=https://<r2-or-release-url>/wikipedia-2026-10-01.snapshot
EXPECTED_POINTS=87173
COLLECTION=wikipedia

# The model Ollama pulls once into its volume (`docker compose --profile setup
# run --rm pull-model`). Modal bakes it into the image instead.
LLM_MODEL=llama3.2:3b

# The public demo's budget per visitor. Kept low on purpose: one Oracle box
# answers one question at a time.
RATE_LIMIT_QUERY_PER_MINUTE=6
RATE_LIMIT_QUERY_BURST=10
