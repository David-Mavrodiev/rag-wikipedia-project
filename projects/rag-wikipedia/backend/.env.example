# Copy to .env in THIS directory (backend/) and edit.
#
# Settings reads env_file=".env" relative to the process working directory, and
# the runbook starts uvicorn from backend/, so backend/.env is the file that is
# actually picked up. Every value below is the built-in default: an empty .env
# is a valid .env. Ranges are enforced at startup - an out-of-range value fails
# fast with a validation error instead of silently changing retrieval.

# ---------- Services ----------
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434

# ---------- Models ----------
EMBED_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=llama3.2:3b
# LLM_NUM_CTX: 512-131072. Context window requested from Ollama on every
# request. Ollama sizes its compute buffers from this, and llama3.2's advertised
# 128k overflows a 6 GB GPU, so the app pins it rather than inheriting the
# server default. Must exceed TOKEN_BUDGET plus prompt and answer headroom.
LLM_NUM_CTX=8192
# LLM_KEEP_ALIVE: an Ollama duration ("30m", "1h30m"; "0" unloads at once, "-1"
# never). How long the model stays loaded after a request. Ollama's own default
# is 5m, after which the next answer pays a model reload (13.2 s measured).
LLM_KEEP_ALIVE=30m
# WARMUP_ON_STARTUP: true | false. Load the embedder and the LLM in the
# background at startup so the first request does not pay for it (75.4 s
# measured cold, against 2.9-4.9 s warm). /health answers while they load.
WARMUP_ON_STARTUP=true

# ---------- Corpus ----------
COLLECTION=wikipedia
# tiny | real - selects the ingestion profile.
PROFILE=tiny

# ---------- Retrieval ----------
# TOP_K: 1-100. Chunks passed to the model.
TOP_K=5
# TOKEN_BUDGET: >= 1. Context budget in tokens.
TOKEN_BUDGET=3000
# RETRIEVAL_CANDIDATE_K: 1-1000. Candidates fetched before re-ranking.
RETRIEVAL_CANDIDATE_K=20
# RERANK_MODEL: a cross-encoder name, or empty. EMPTY IS OFF - nothing is loaded
# and retrieval is unchanged. Measured with cross-encoder/ms-marco-MiniLM-L-6-v2:
# end-to-end false accepts 0.150 -> 0.000, answerable refusals 0.150 -> 0.183,
# p50 1.79 s -> 2.42 s (docs/relevance-gate.md). An 8B model does better without
# it, so this is for deployments that cannot afford one.
RERANK_MODEL=
# RERANK_MIN_RELEVANCE: 0.0-1.0. Refuse when the best passage scores below this.
# 0.9 was fitted on serving_golden and tested on serving_detail; re-fit it for a
# different question style, where the same value was four times harsher.
RERANK_MIN_RELEVANCE=0.9

# ---------- Refusal thresholds (all 0.0-1.0 unless noted) ----------
# These five are the ones a `--auto-correct` audit may rewrite and persist to
# backend/eval/runtime_config.json, which is re-applied on the next startup and
# logged at INFO. Anything logged there overrides what you set here.
REFUSAL_THRESHOLD=0.3
REFUSAL_MIN_SCORE=0.45
REFUSAL_HIGH_CONFIDENCE_SCORE=0.78
REFUSAL_MIN_MARGIN=0.02
# REFUSAL_MIN_OVERLAP_TERMS: 0-50. Query terms that must appear in the evidence.
# Counting only; superseded by REFUSAL_MIN_EVIDENCE_COVERAGE wherever an IDF
# table exists. Still the gate on a collection with no table built.
REFUSAL_MIN_OVERLAP_TERMS=1
# REFUSAL_MIN_EVIDENCE_COVERAGE: 0.0-1.0. Fraction of the question's IDF weight
# the evidence must cover. Weights each shared term by how much it narrows the
# corpus, so a common word landing in an unrelated chunk no longer buys an
# accept the way it did under the bare count above.
#
# 0.0 means DISABLED, not "accept anything" - read as a literal threshold, zero
# would pass every result clearing the score floor and ship a WEAKER gate than
# the count it replaces. Zero is also what a collection with no IDF table falls
# back to, so `make idf` is a prerequisite for this setting doing anything.
#
# 0.45 was MEASURED on the serving corpus (87,173 chunks) on 2026-09-12:
# false_accept_rate 0.600 -> 0.500, for answerable_refusal_rate 0.000 -> 0.033.
# It does NOT transfer between corpora - the weighting tightens as a corpus
# grows - so re-measure with scripts/sweep_coverage.py after any ingest that
# changes what you serve.
REFUSAL_MIN_EVIDENCE_COVERAGE=0.45

# ---------- HTTP ----------
# Comma-separated origins, or * for any.
ALLOWED_ORIGINS=*

# ---------- Rate limiting ----------
# Requires Redis when enabled: POST /query answers 503 if the limiter cannot
# reach it. Set false for a single-machine demo with no Redis.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
# Both >= 1.
RATE_LIMIT_QUERY_PER_MINUTE=10
RATE_LIMIT_QUERY_BURST=20
# Header carrying the client identity behind a proxy, e.g. X-Forwarded-For.
# Empty means use the socket peer address.
RATE_LIMIT_CLIENT_HEADER=

# ---------- Quality audit ----------
# Gates POST /quality/audit?auto_correct=true, which REWRITES AND PERSISTS the
# refusal thresholds above. Empty (the default) disables auto-correction
# entirely rather than leaving it open; callers get 503.
# Send it as the X-Quality-Token header.
QUALITY_ADMIN_TOKEN=

# ---------- Provider selection (backend/providers/) ----------
# ONE value swaps the model behind the LLM / Embedder interfaces. These
# defaults are exactly what the served path builds today, so leaving them unset
# changes nothing about what runs.
#   LLM_CHOICE   = ollama-3b | ollama-1b | vertex
#   EMBED_CHOICE = bge | vertex
LLM_CHOICE=ollama-3b
EMBED_CHOICE=bge

# Vertex AI. Needs the `gcp` extra (`uv sync --extra gcp`) and Application
# Default Credentials - `gcloud auth application-default login`, or a service
# account via GOOGLE_APPLICATION_CREDENTIALS. There is no API key to set.
# GCP_PROJECT may stay empty: Vertex resolves the project from those
# credentials, so setting it is only needed to override that.
#
# CHANGING EMBED_CHOICE CHANGES THE VECTOR DIMENSION. bge-small is 384-d and
# text-embedding-005 is 768-d, and vectors of different dimensions are not
# interchangeable. ensure_collection() compares the embedder's PROBED dimension
# against the size the collection was CREATED at and refuses a mismatch naming
# both numbers - so this stops at startup rather than corrupting a corpus, but
# it does mean switching embedder requires a re-ingest into a NEW collection.
GCP_PROJECT=
GCP_LOCATION=us-central1
VERTEX_LLM_MODEL=gemini-2.0-flash
VERTEX_EMBED_MODEL=text-embedding-005

# ---------- Authentication (Clerk) ----------
# AUTH_MODE: off | optional | required. Default off, and anything other than
# `off` falls back to off when CLERK_ISSUER is empty - a missing key disables
# the feature rather than locking everyone out of a running demo.
#   optional  a token is verified when present; without one the request is
#             anonymous. What the public demo runs: a visitor must be able to
#             ask a question without signing up.
#   required  no valid token, no answer (401).
AUTH_MODE=off
# From the Clerk dashboard (API keys -> Show JWT public key / Frontend API URL),
# e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
# Only if the JWT template sets one; leave empty otherwise.
CLERK_AUDIENCE=
#
# The frontend needs VITE_CLERK_PUBLISHABLE_KEY (frontend/.env or the Vercel
# project settings). The SECRET key is never needed here: this service verifies
# tokens against Clerk's published keys, it never calls Clerk's API.
